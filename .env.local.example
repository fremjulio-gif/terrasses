# ========================================================
# TERRASSES - Configuration Google Drive & Sécurité Admin
# ========================================================

# Code PIN du mode Admin (Easter egg: 5 clics sur "TERRASSES" ou Cmd+Shift+M)
ADMIN_PIN=0000

# Dossier Google Drive de destination pour l'hébergement des .wav/.mp3 et terrasses-db.json
# (Copiez l'ID qui se trouve à la fin de l'URL de votre dossier Google Drive)
GOOGLE_DRIVE_FOLDER_ID=

# Compte de service Google Drive (Google Cloud Service Account)
# Nécessite l'activation de l'API Google Drive v3
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Fallback local : si les identifiants Drive ne sont pas encore renseignés,
# l'application bascule automatiquement et de manière 100% transparente
# sur la base de données locale 'src/data/local-db.json' et les fichiers locaux.
